# Example environment variables for Cultura Chatbot
# Copy this file to `.env` (for local development) or set the values in your deployment
# Do NOT commit a `.env` file that contains real secrets or API keys.

# Comma-separated Gemini API keys (primary, backup1, backup2...)
# Example: your-primary-gemini-key,your-backup-key-1,your-backup-key-2
GEMINI_API_KEYS=your-primary-gemini-key,your-backup-key-1,your-backup-key-2

# JWT secret used to sign session tokens (change in production)
JWT_SECRET=your-jwt-secret

# Frontend build-time/runtime values
VITE_API_BASE=http://localhost:3001

# If you host a separate Python TTS/STT server, set its base URL here (optional)
VITE_TTS_BASE=http://localhost:5000

# Optional: default voice for Edge TTS (used by Python server)
EDGE_TTS_VOICE=en-IN-PrabhatNeural
