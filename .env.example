# Example environment variables for Cultura Chatbot
# Copy this to `.env` (for local development) or set the values in Vercel project settings.

# Comma-separated Gemini API keys (primary, backup1, backup2...)
GEMINI_API_KEYS=your_primary_key,your_backup_key_1,your_backup_key_2

# JWT secret used to sign session tokens (change in production)
JWT_SECRET=super-secret-change-me

# Frontend build-time/runtime values
# Leave VITE_API_BASE blank to use same-origin (recommended for Vercel deployments)
VITE_API_BASE=
# If you host a separate Python TTS/STT server, set its base URL here (optional)
VITE_TTS_BASE=

# Optional: default voice for Edge TTS (used by Python server)
EDGE_TTS_VOICE=en-IN-PrabhatNeural
