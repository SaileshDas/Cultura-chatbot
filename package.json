{
  "name": "cultura-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "dev": "concurrently \"cd frontend && npm run dev\" \"cd backend && nodemon server.js\""
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^1.29.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "nodemon": "^3.1.11"
  }
}
